# Public URL of this landing page (canonical, OG, sitemap). Required for a production build.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3848
# Scorecard app (apps/web). Record, report, verify, and Pro links point here. Required for a production build.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3847
# X handle without the @.
NEXT_PUBLIC_X_HANDLE=justasklens
# Public source repository. The footer GitHub link is hidden when this is empty.
# NEXT_PUBLIC_GITHUB_URL=https://github.com/you/lens
# Copies of the app settings shown on this page. Set them when you change the app's values.
# NEXT_PUBLIC_PRO_PRICE_USDC=10
# NEXT_PUBLIC_PRO_PERIOD_DAYS=30
# NEXT_PUBLIC_FREE_CHECKS_PER_DAY=5
# NEXT_PUBLIC_SWAP_FEE_BPS=50
# NEXT_PUBLIC_PROOF_CLUSTER=devnet
