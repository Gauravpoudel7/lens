generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Mention {
  id           String   @id
  xUserId      String
  xUsername    String
  parentPostId String?
  text         String
  parentText   String?
  status       String
  skipReason   String?
  checkId      String?
  createdAt    DateTime @default(now())
  replies      Reply[]

  @@index([xUserId])
}

model Check {
  id             String    @id
  kind           String
  mentionId      String?
  parentPostId   String?
  tokenMint      String
  tokenSymbol    String
  tokenName      String
  riskLevel      String
  score          Int
  dangerCount    Int
  cautionCount   Int
  unknownCount   Int
  factsJson      String
  snapshotJson   String
  claimsJson     String
  sourcesJson    String
  dataMode       String
  replyText      String
  sourcePostText String?
  priceAtCheck   Float?
  askedBy        String?
  status         String
  error          String?
  xPostId        String?
  /// 1 = before the 2026-10-09 reply data fixes. Reuse needs the current version.
  dataVersion    Int       @default(1)
  createdAt      DateTime  @default(now())
  proof          Proof?
  outcome        Outcome?
  replies        Reply[]

  @@index([parentPostId, tokenMint])
  @@index([tokenMint, createdAt])
  @@index([createdAt])
  @@index([mentionId])
}

model Proof {
  id          String   @id
  checkId     String   @unique
  check       Check    @relation(fields: [checkId], references: [id], onDelete: Cascade)
  contentHash String
  signedAt    DateTime
  payload     String
  txSignature String?
  cluster     String
  status      String
  explorerUrl String?
  createdAt   DateTime @default(now())
}

model Outcome {
  id             String   @id
  checkId        String   @unique
  check          Check    @relation(fields: [checkId], references: [id], onDelete: Cascade)
  priceAtCheck   Float?
  priceAtScore   Float?
  priceChangePct Float?
  windowDays     Int
  labelCorrect   Boolean?
  callResult     String
  scoredAt       DateTime @default(now())
}

model Reply {
  id        String   @id
  mentionId String
  mention   Mention  @relation(fields: [mentionId], references: [id], onDelete: Cascade)
  checkId   String
  check     Check    @relation(fields: [checkId], references: [id], onDelete: Cascade)
  xReplyId  String?
  text      String
  cached    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([mentionId])
}

model UsageDay {
  id      String @id
  xUserId String
  day     String
  count   Int    @default(0)

  @@unique([xUserId, day])
}

model ChainMemo {
  signature String   @id
  payload   String
  cluster   String
  createdAt DateTime @default(now())
}

model BotCursor {
  id      String @id
  sinceId String
}

model Account {
  id        String    @id
  xUserId   String?   @unique
  xHandle   String?   @unique
  wallet    String?   @unique
  tier      String    @default("free")
  proUntil  DateTime?
  /// Set only when this X account DMed a valid link code to the bot.
  xLinkedAt DateTime?
  createdAt DateTime  @default(now())
  watches   Watch[]
  payments  Payment[]
  alerts    Alert[]
  linkCodes LinkCode[]

  @@map("accounts")
}

model LinkCode {
  code          String    @id
  userId        String
  user          Account   @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  usedAt        DateTime?
  usedByXUserId String?
  createdAt     DateTime  @default(now())

  @@index([userId])
}

model Watch {
  id        String   @id
  userId    String
  user      Account  @relation(fields: [userId], references: [id], onDelete: Cascade)
  mint      String
  symbol    String
  createdAt DateTime @default(now())

  @@unique([userId, mint])
  @@index([mint])
}

model Payment {
  id        String   @id
  userId    String
  user      Account  @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  reference String   @unique
  amountUsd Float
  amountRaw String
  mint      String
  recipient String
  signature String?
  status    String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Alert {
  id         String   @id
  userId     String
  user       Account  @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkId    String
  mint       String
  text       String
  channel    String
  status     String
  xMessageId String?
  createdAt  DateTime @default(now())

  @@unique([userId, checkId])
  @@index([status])
}

model OutboundDay {
  day   String @id
  count Int    @default(0)
}

// Rotated OAuth 2.0 user tokens. One row, id "oauth2".
// The refresh token changes every refresh, so the database copy wins over .env.
model XOAuth2Token {
  id           String   @id
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime
}

// Daily editorial posts (tips, terms, recaps). Separate from Check so the scorecard is unchanged.
model EditorialPost {
  id          String   @id
  kind        String
  /// UTC yyyy-mm-dd of the slot.
  day         String
  text        String
  contentHash String
  payload     String
  txSignature String?
  cluster     String
  xPostId     String?
  /// proved | posted | post_failed | duplicate | skipped
  status      String
  recapSource String?
  error       String?
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([kind, day])
  @@index([status, createdAt])
}
