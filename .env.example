# Copy to .env if you want to override the defaults.
# With no .env file, Lens runs in mock mode and stores data/lens.db.
# Never commit .env or keypair files.

# sqlite file. Prefer an absolute file: URL. Relative paths are resolved
# from prisma/schema.prisma, so "file:../data/lens.db" is the repo data folder.
# DATABASE_URL="file:../data/lens.db"

# mock (default) or live. Live reads DexScreener, Solana RPC, and RugCheck.
# Birdeye is used only when BIRDEYE_API_KEY is set.
DATA_MODE=mock

# mock (default) or solana. Solana writes a memo on SOLANA_CLUSTER before posting.
PROOF_MODE=mock

# mock (default) or live. Live needs the X user-context keys below.
X_MODE=mock

# auto uses the LLM when LLM_API_KEY or OPENAI_API_KEY is set, otherwise the template.
# template always uses the deterministic reply.
LLM_MODE=auto

PUBLIC_BASE_URL=http://127.0.0.1:3847
# Plain-text name in link-free replies, for example Lens. Leave empty while the site
# is not public. A localhost PUBLIC_BASE_URL does not add a scorecard line.
# A dotted name can still be read as a link by X.
# PUBLIC_SITE_NAME=

# Proofs default to devnet. Token reads always use mainnet data.
SOLANA_CLUSTER=devnet
# SOLANA_RPC_URL=https://api.devnet.solana.com
# DATA_RPC_URL=https://api.mainnet-beta.solana.com
# HELIUS_API_KEY=
# If HELIUS_API_KEY is set and DATA_RPC_URL is empty, mainnet Helius is used.

# JSON array (solana-keygen) or base58 secret, or a path to a keypair file.
# SOLANA_KEYPAIR=
# SOLANA_KEYPAIR_PATH=data/devnet-keypair.json

# Optional richer security fields, including creator sold percent when Birdeye provides it.
# BIRDEYE_API_KEY=

# OpenAI-compatible chat completions. The model only writes text.
# LLM_API_KEY=
# OPENAI_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# X API. Needed only for X_MODE=live.
# X_AUTH_MODE=oauth2 uses a confidential OAuth 2.0 user (PKCE). oauth1 is the default.
# X_AUTH_MODE=oauth1
# OAuth 1.0a user context:
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
# OAuth 2.0 user context. Access tokens last 2 hours. Refresh tokens rotate and are saved
# in the database and in data/x-oauth2.json (gitignored). Run npm run x:oauth2-login to mint them.
# X_OAUTH2_CLIENT_ID=
# X_OAUTH2_CLIENT_SECRET=
# X_OAUTH2_ACCESS_TOKEN=
# X_OAUTH2_REFRESH_TOKEN=
# X_OAUTH2_REDIRECT_URI=http://127.0.0.1:4391/callback
# Optional app-only read of a parent post. Posting and DMs still use the user token.
# X_BEARER_TOKEN=
# X_BOT_USER_ID is optional. If unset, the worker calls /2/users/me once, saves the id,
# and logs a hint to set this so the next start skips that call.
# X_BOT_USER_ID=
# X Pay Per Use bills a post that contains a URL much higher than one that does not.
# Leave false so replies, outbound posts, and warning DMs stay link-free.
X_REPLY_LINKS=false
# When true (the default), a mention that says buy, swap, or trade can include one
# Blink URL for a LOW or MEDIUM token. HIGH, unscored tickers, and a localhost
# PUBLIC_BASE_URL never get that link. Set false to keep every reply link-free.
# X_SWAP_LINKS_ON_REQUEST=true

# Free checks per X user per UTC day. Pro accounts skip this.
RATE_LIMIT_PER_USER_PER_DAY=5
# Bot-wide replies per UTC day. The worker stops replying when this is reached.
MAX_X_REPLIES_PER_DAY=50
# Manual check form, per IP, per process, per hour.
CHECK_API_LIMIT_PER_HOUR=30

# Outcome job. A HIGH label is "right" if price change <= SHARP_DROP_PCT.
# A call wins if price change >= CALL_WIN_PCT. Window is days after the check.
OUTCOME_WINDOW_DAYS=7
SHARP_DROP_PCT=-30
CALL_WIN_PCT=20

POLL_INTERVAL_MS=180000

# How many times to retry a 429 or a dropped RPC call.
RPC_RETRY_ATTEMPTS=4

# Worker posts calls and warnings when enabled. Empty mint list is fine if discovery is on.
OUTBOUND_ENABLED=false
# OUTBOUND_MINTS=
# Also pull DexScreener token profiles and boosts, then post HIGH warnings and LOW calls.
OUTBOUND_DISCOVER=false
# Calls plus warnings posted per UTC day, including the mint list above.
OUTBOUND_DAILY_CAP=8

# Pro is a USDC transfer on Solana mainnet, checked on-chain. Proofs stay on SOLANA_CLUSTER.
# PRO_TREASURY_WALLET=
PRO_PRICE_USDC=10
PRO_PERIOD_DAYS=30
# Unpaid Solana Pay links older than this are reported as expired. A full transfer still confirms.
PRO_CHECKOUT_TTL_HOURS=24
# Leave USDC_MINT empty for mainnet USDC. Set the Circle devnet mint only if you are testing payments on devnet.
# USDC_MINT=
# PRO_RPC_URL defaults to the mainnet data RPC, because the USDC payment is on mainnet.
# PRO_RPC_URL=

# Jupiter. lite-api.jup.ag is being phased out. Same paths on api.jup.ag:
# GET /swap/v1/quote, POST /swap/v1/swap, GET /price/v3.
# Keyless access works. Set JUPITER_API_KEY to send the x-api-key header.
JUPITER_BASE_URL=https://api.jup.ag
# JUPITER_API_KEY=
JUPITER_FEE_BPS=50
# A 0.5% platform fee is added only when JUPITER_FEE_ACCOUNT is set.
# JUPITER_FEE_ACCOUNT=
