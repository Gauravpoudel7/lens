{
  "name": "lens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx scripts/ensure-db.ts && npm run dev -w @lens/web",
    "start": "npm run start -w @lens/web",
    "build": "npm run build -w @lens/web",
    "worker": "tsx apps/worker/src/index.ts",
    "worker:once": "tsx apps/worker/src/index.ts --once",
    "demo": "tsx scripts/demo.ts",
    "setup:devnet": "tsx scripts/setup-devnet.ts",
    "demo:devnet": "tsx scripts/demo-devnet.ts",
    "discover": "tsx scripts/discover.ts",
    "live:sample": "tsx scripts/live-sample.ts",
    "x:oauth2-login": "tsx scripts/x-oauth2-login.ts",
    "doctor": "tsx scripts/doctor.ts",
    "post": "tsx scripts/post.ts",
    "score": "tsx scripts/score.ts",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/db --noEmit && tsc -p apps/worker --noEmit",
    "db:push": "tsx scripts/ensure-db.ts",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "lint": "npm run lint -w @lens/web"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "dotenv": "^17.2.2"
  }
}
